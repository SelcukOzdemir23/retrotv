---
import Layout from "../layouts/Layout.astro";
import Screen from "../components/TV/Screen.svelte";
import ContentBrowser from "../components/TV/ContentBrowser.svelte";
import KeyGate from "../components/TV/KeyGate.svelte";
---

<Layout title="RetroTV — Movie & TV Streaming">
    <main class="min-h-[100dvh] w-full">
        <KeyGate client:load>
            <Screen client:load />
            <ContentBrowser client:load />
        </KeyGate>
    </main>
</Layout>
