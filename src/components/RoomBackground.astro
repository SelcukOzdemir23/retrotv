---
const bgUrl = import.meta.env.BASE_URL + 'room-bg.png';
---

<div class="fixed inset-0 w-full h-full bg-black overflow-hidden" style="z-index: -50;">
    <!-- Nostalgic Room Photo -->
    <div
        class="absolute inset-0 bg-cover bg-center transition-opacity duration-1000"
        style={`background-image: url('${bgUrl}'); filter: blur(8px) brightness(0.6); transform: scale(1.1);`}
    >
    </div>

    <!-- Vignette Overlay -->
    <div class="absolute inset-0" style="background: radial-gradient(circle at center, transparent 40%, rgba(0,0,0,0.5) 70%, rgba(0,0,0,0.85) 100%);">
    </div>
</div>
